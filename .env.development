# ───────── 开发环境（本地）─────────
APP_ENV=development
AUTH_CENTER_PORT=3100

# 本地 Docker MySQL（阶段拆分时期与 nexharness 共用同一库）
DATABASE_URL=mysql://root:nexroot@127.0.0.1:3308/nexharness

# 允许的回跳/来源名单（逗号分隔）：
# - http(s) origin：登录回跳目标（消费方地址）
# - 自定义 scheme（如桌面深链 nexharness:）
# 覆盖：nexharness Web(:3000)、auth-center 门户(:3101)、桌面深链。
AUTH_CENTER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3101,http://127.0.0.1:3101,nexharness:
