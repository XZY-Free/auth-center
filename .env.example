# ───────── auth-center 环境变量样例 ─────────
#
# 加载优先级（高 → 低）：平台注入 / 命令行 > .env.{APP_ENV}.local > .env.{APP_ENV}
# 密钥一律放 .env.{APP_ENV}.local（git 忽略），不要写进本文件。

# ─── 服务 ───
APP_ENV=development
AUTH_CENTER_PORT=3100

# ─── 数据库（阶段拆分时期与 nexharness 共用同一库）───
DATABASE_URL=mysql://user:password@host:3306/nexharness

# ─── 回跳 / 来源允许名单（逗号分隔）───
# - http(s) origin：登录回跳目标（消费方地址，防开放重定向）
# - 自定义 scheme：桌面深链等（如 nexharness:）
AUTH_CENTER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3101,nexharness:
