# ───────── auth-center 环境变量样例 ─────────
#
# 加载优先级（高 → 低）：平台注入 / 命令行 > .env.{APP_ENV}.local > .env.{APP_ENV}
# 密钥一律放 .env.{APP_ENV}.local（git 忽略），不要写进本文件。

# ─── 服务 ───
APP_ENV=development
AUTH_CENTER_PORT=3100

# ─── 数据库（阶段拆分时期与 nexharness 共用同一库）───
DATABASE_URL=mysql://user:password@host:3306/nexharness
